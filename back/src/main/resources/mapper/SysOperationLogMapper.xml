<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.SysOperationLogMapper">

    <resultMap type="com.example.domain.SysOperationLog" id="SysOperationLogResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="operationType"    column="operation_type"    />
        <result property="operationContent"    column="operation_content"    />
        <result property="operationResult"    column="operation_result"    />
        <result property="operationIp"    column="operation_ip"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createdAt"    column="created_at"    />
    </resultMap>

    <sql id="selectSysOperationLogVo">
        select id, user_id, operation_type, operation_content, operation_result, operation_ip, is_deleted, created_at from t_sys_operation_log
    </sql>

    <select id="selectSysOperationLogList" parameterType="com.example.domain.SysOperationLog" resultMap="SysOperationLogResult">
        <include refid="selectSysOperationLogVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="operationType != null  and operationType != ''"> and operation_type = #{operationType}</if>
            <if test="operationContent != null  and operationContent != ''"> and operation_content like concat('%', #{operationContent}, '%')</if>
            <if test="operationResult != null "> and operation_result = #{operationResult}</if>
            <if test="params.beginCreatedAt != null and params.beginCreatedAt != '' and params.endCreatedAt != null and params.endCreatedAt != ''"> and created_at between #{params.beginCreatedAt} and #{params.endCreatedAt}</if>
        </where>
    </select>

    <select id="selectSysOperationLogById" parameterType="Long" resultMap="SysOperationLogResult">
        <include refid="selectSysOperationLogVo"/>
        where id = #{id}
    </select>

    <insert id="insertSysOperationLog" parameterType="com.example.domain.SysOperationLog" useGeneratedKeys="true" keyProperty="id">
        insert into t_sys_operation_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="operationType != null and operationType != ''">operation_type,</if>
            <if test="operationContent != null">operation_content,</if>
            <if test="operationResult != null">operation_result,</if>
            <if test="operationIp != null">operation_ip,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createdAt != null">created_at,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="operationType != null and operationType != ''">#{operationType},</if>
            <if test="operationContent != null">#{operationContent},</if>
            <if test="operationResult != null">#{operationResult},</if>
            <if test="operationIp != null">#{operationIp},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createdAt != null">#{createdAt},</if>
        </trim>
    </insert>

    <update id="updateSysOperationLog" parameterType="com.example.domain.SysOperationLog">
        update t_sys_operation_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="operationType != null and operationType != ''">operation_type = #{operationType},</if>
            <if test="operationContent != null">operation_content = #{operationContent},</if>
            <if test="operationResult != null">operation_result = #{operationResult},</if>
            <if test="operationIp != null">operation_ip = #{operationIp},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysOperationLogById" parameterType="Long">
        delete from t_sys_operation_log where id = #{id}
    </delete>

    <delete id="deleteSysOperationLogByIds" parameterType="String">
        delete from t_sys_operation_log where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>