<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.NewsMapper">

    <resultMap type="com.example.domain.News" id="NewsResult">
        <result property="id"    column="id"    />
        <result property="title"    column="title"    />
        <result property="summary"    column="summary"    />
        <result property="categoryId"    column="category_id"    />
        <result property="categoryName"    column="category_name"    />
        <result property="coverUrl"    column="cover_url"    />
        <result property="content"    column="content"    />
        <result property="publishStatus"    column="publish_status"    />
        <result property="shelfStatus"    column="shelf_status"    />
        <result property="publishUserId"    column="publish_user_id"    />
        <result property="publishTime"    column="publish_time"    />
        <result property="version"    column="version"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectNewsVo">
        select n.id, n.title, n.summary, n.category_id, n.cover_url, n.content, n.publish_status, n.shelf_status, n.publish_user_id, n.publish_time, n.version, n.is_deleted, n.created_at, n.updated_at, c.category_name as category_name
        from t_news n
                 left join t_news_category c on n.category_id = c.id
    </sql>

    <select id="selectNewsList" parameterType="com.example.domain.News" resultMap="NewsResult">
        <include refid="selectNewsVo"/>
        <where>
            <if test="title != null  and title != ''"> and n.title like concat('%', #{title}, '%')</if>
            <if test="categoryId != null "> and n.category_id = #{categoryId}</if>
            <if test="publishStatus != null "> and n.publish_status = #{publishStatus}</if>
            <if test="shelfStatus != null "> and n.shelf_status = #{shelfStatus}</if>
        </where>
    </select>

    <select id="selectNewsById" parameterType="Long" resultMap="NewsResult">
        <include refid="selectNewsVo"/>
        where n.id = #{id}
    </select>

    <insert id="insertNews" parameterType="com.example.domain.News" useGeneratedKeys="true" keyProperty="id">
        insert into t_news
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="summary != null">summary,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="coverUrl != null">cover_url,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="publishStatus != null">publish_status,</if>
            <if test="shelfStatus != null">shelf_status,</if>
            <if test="publishUserId != null">publish_user_id,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="version != null">version,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="summary != null">#{summary},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="coverUrl != null">#{coverUrl},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="publishStatus != null">#{publishStatus},</if>
            <if test="shelfStatus != null">#{shelfStatus},</if>
            <if test="publishUserId != null">#{publishUserId},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="version != null">#{version},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
        </trim>
    </insert>

    <update id="updateNews" parameterType="com.example.domain.News">
        update t_news
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="coverUrl != null">cover_url = #{coverUrl},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="publishStatus != null">publish_status = #{publishStatus},</if>
            <if test="shelfStatus != null">shelf_status = #{shelfStatus},</if>
            <if test="publishUserId != null">publish_user_id = #{publishUserId},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="version != null">version = #{version},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNewsById" parameterType="Long">
        delete from t_news where id = #{id}
    </delete>

    <delete id="deleteNewsByIds" parameterType="String">
        delete from t_news where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>