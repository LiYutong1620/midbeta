{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.vue", "src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "module": "ESNext",
    "target": "ES2020"
  }
}